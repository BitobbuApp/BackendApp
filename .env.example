# Core Settings
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bitobbu?schema=public"

# Email Service (Nodemailer + Mailgun MVP)
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=no-reply@bitobbu.com
EMAIL_FROM_NAME=Bitobbu
# Mailgun SMTP Settings
EMAIL_MAILGUN_SMTP_HOST=smtp.mailgun.org
EMAIL_MAILGUN_SMTP_PORT=587
EMAIL_MAILGUN_SMTP_USER=postmaster@your_mailgun_domain
EMAIL_MAILGUN_SMTP_PASS=your_mailgun_smtp_password
# Mailgun Template Names
EMAIL_TEMPLATE_WELCOME=welcome_template_name
EMAIL_TEMPLATE_PASSWORD_RESET=password_reset_template_name
EMAIL_TEMPLATE_VERIFICATION=verification_template_name
