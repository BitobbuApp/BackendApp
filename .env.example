# Core Settings
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bitobbu?schema=public"

# Email Service (Nodemailer + Brevo MVP)
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=no-reply@bitobbu.com
EMAIL_FROM_NAME=Bitobbu
# Brevo SMTP Settings (obtain from Brevo Dashboard -> SMTP & API)
EMAIL_BREVO_SMTP_HOST=smtp-relay.brevo.com
EMAIL_BREVO_SMTP_PORT=587
EMAIL_BREVO_SMTP_USER=your_brevo_smtp_login
EMAIL_BREVO_SMTP_PASS=your_brevo_smtp_key
# Brevo Template IDs
EMAIL_TEMPLATE_WELCOME=1
EMAIL_TEMPLATE_PASSWORD_RESET=2
EMAIL_TEMPLATE_VERIFICATION=3
