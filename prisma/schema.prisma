  pending_review
  completed
  cancelled
}

enum ReviewStatus {
  pending
  submitted
  expired
}

enum AdminRole {
  superadmin
  ops_admin
}

enum SocialPlatform {
  instagram
  tiktok
  facebook
  website
  google_business
  linkedin
  twitter
}

model RequestInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  request_id  String    @db.Uuid
  company_id  String    @db.Uuid
  tier        Int       @db.SmallInt
  score       Decimal   @db.Decimal(4, 3)
  status      String    @default("PENDING") @db.VarChar(20)
  notified_at DateTime? @db.Timestamptz(6)
  viewed_at   DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)

  request Request @relation(fields: [request_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([request_id, company_id])
  @@index([company_id, status])
  @@index([request_id, tier])
  @@index([status, created_at])
  @@map("request_invitations")
}
