# Dependencies (re-installed inside the image)
node_modules

# Compiled output (re-built inside the image)
dist

# Environment secrets — inject via docker run --env-file or Docker Compose
.env
.env.*

# Git history
.git
.gitignore

# Editor / OS
.vscode
.idea
*.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# TypeScript source maps (not needed at runtime)
**/*.map

# Prisma migrations are applied separately, not inside the image build
# prisma/migrations   ← keep commented; include if you want them available
